# Copie este arquivo para ".env" e preencha com valores reais (nunca comite o .env).
# Estas variáveis não são carregadas automaticamente pelo Django/manage.py;
# sirva de referência para configurar variáveis de ambiente localmente ou no Render.

# Chave secreta do Django. Em produção, gere uma nova e mantenha em segredo.
SECRET_KEY=troque-por-uma-chave-secreta-gerada

# "True" em desenvolvimento, "False" em produção.
DEBUG=False

# String de conexão do PostgreSQL (Render define isso automaticamente ao
# conectar o banco ao serviço web). Deixe vazia/ausente para usar SQLite local.
# Formato: postgres://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=

# Credenciais dos 2 usuários de acesso ao sistema (login), criadas
# automaticamente pelo build.sh via "manage.py criar_usuarios_producao".
# NUNCA preencha valores reais aqui nem no .env comitado — configure-as
# apenas na aba "Environment" do serviço web no painel do Render.
# Se alguma dessas variáveis faltar, o comando apenas pula aquele usuário
# (não quebra o build); se o usuário já existir, é ignorado (idempotente).
USUARIO_1_NOME=
USUARIO_1_SENHA=
USUARIO_2_NOME=
USUARIO_2_SENHA=
